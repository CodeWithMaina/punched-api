# Docker context ignore - PunchedApi (.NET 8 API + worker)
# Governs what `COPY . ./` in PunchedApi/Dockerfile can reach.
# appsettings.json IS required (base config) -> it stays.

# Build outputs
bin/
obj/

# Nested test project: builds its own binaries and is excluded from this
# project's compile items in PunchedApi.csproj. Keeping it out of the context
# stops the test tree's bin/obj from inflating every build.
PunchedApi.Tests/

# NuGet / IDE / editor user files
*.user
*.suo
*.swp
*.swo
*.userosscache
*.sln.doc
*.vspscc
*.vssscc
.vs/
.vscode/
.idea/

# Next.js generated (not used here, but harmless to guard)
*.tsbuildinfo
next-env.d.ts

# Environment & secrets - NEVER copy real env/config into images
.env
.env.*
!.env.example
.env.local
.env.*.local
*.pfx
*.key
*.pem
*.p12
*.crt
*.cer

# .NET environment override that may hold real secrets -> keep local
appsettings.Development.json
appsettings.Development.json.example
appsettings.Production.json
appsettings.Staging.json
appsettings.*.json.user
# (appsettings.json stays tracked & is copied into the image)

# Local filesystem object store (MediaStorage:Provider=local)
App_Data/

# Dev scratch / docs / tests
notes.md
*.md
SEEDING.md
docs/
scripts/
tests/
test/
TestResults/
coverage/

# Logs
*.log
logs/
seed-report.json

# OS
.DS_Store
Thumbs.db


