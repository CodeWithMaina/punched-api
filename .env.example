# =============================================================================
# Punched API - Environment Template
# =============================================================================
# PRODUCTION HOST (Railway, Render, etc.): set each variable below directly
#   on the service. Nested config keys use a double underscore (__). Credentials
#   go in the host's variable store - never commit real credentials.
#
# LOCAL DOCKER COMPOSE only: copy this file to `.env` in this repo root; compose
#   maps the "LOCAL DOCKER COMPOSE ONLY" block below into the app automatically.
# =============================================================================


# ---- Database (Neon / Postgres) ----
# Full URL form;the resolver converts it to Npgsql keyword form automatically.

# IMPORTANT: drop `channel_binding=require` (incompatible); keep `sslmode=require`.
# Replace EVERYTHING between <...> - do NOT keep the placeholder literals.

DATABASE_URL=postgresql://<NEON_DB_USER>:<YOUR_REAL_PASSWORD>@<YOUR_NEON_HOST>.aws.neon.tech/<YOUR_DB_NAME>?sslmode=require


# ---- Alternative: keyword-form connection string (use EITHER this OR DATABASE_URL; NOT both) ----
# CONNECTION_STRINGS__DEFAULT_CONNECTION=Host=<YOUR_NEON_HOST>;Port=5432;Database=<YOUR_DB_NAME>;Username=<NEON_DB_USER>;Password=<YOUR_REAL_PASSWORD>;SSL Mode=Require


# ---- JWT (Secret REQUIRED; >=32 chars) ----
JwtSettings__Secret=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
JwtSettings__Issuer=PunchedApi
JwtSettings__Audience=PunchedApp
JwtSettings__AccessTokenExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=30


# ---- Billing (payment webhook HMAC secret) ----
# Blank = webhooks rejected (fail-closed)。
Billing__WebhookSecret=CHANGE_THIS_TO_YOUR_PAYMENT_WEBHOOK_SECRET


# ---- Email / SMTP ----
Email__Host=smtp.yourprovider.com
Email__Port=587
Email__Username=YOUR_SMTP_USERNAME
Email__Password=YOUR_SMTP_PASSWORD
Email__FromAddress=noreply@punched.app
Email__FromName=Punched


# ---- Public app base URLs ----
# Base URL of the UI - builds staff-invitation / verification email links。
PublicApp__BaseUrl=https://<YOUR_UI_DOMAIN>.up.railway.app
PublicApp__InvitationExpiryDays=7


# ---- CORS (UI origins allowed to call the API) ----
# Match PublicApp__BaseUrl; add more with __1, __2, etc。
CorsOrigins__0=https://<YOUR_UI_DOMAIN>.up.railway.app


# ---- Stamping ecosystem ----
Stamping__WinBackDays=30
Stamping__WinBackCronHours=24


# ---- Seed (demo data; DISABLE in production) ----
Seed__Enabled=false
Seed__GenerateReport=false
# Seed__BusinessCount=5


# =============================================================================
# LOCAL DOCKER COMPOSE ONLY (not used on Railway)
# =============================================================================
DB_PASSWORD=changeme
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARS_LONG

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@punched.app

PUBLIC_APP_BASE_URL=http://localhost:3000
PUBLIC_APP_INVITATION_EXPIRY_DAYS=7