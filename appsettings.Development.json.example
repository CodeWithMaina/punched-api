{
  "//": "Copy this file to appsettings.Development.json and edit with LOCAL dev values only. Never commit real cloud credentials.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=punched_db;Username=postgres;Password=changeme;SSL Mode=Prefer;"
  },
  "JwtSettings": {
    "Secret": "dev-secret-key-for-local-testing-only-change-in-production-32chars!!",
    "Issuer": "PunchedApi",
    "Audience": "PunchedApp",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Seed": {
    "Enabled": true,
    "ResetDatabase": false,
    "ClearExistingData": false,
    "AppendData": false,
    "GenerateReport": true,
    "RandomSeed": 12345,
    "BusinessCount": 5,
    "VerboseLogging": true,
    "ReportPath": "seed-report.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "MediaStorage": {
    "Provider": "r2",
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PrivateBucket": "punched-media-originals",
    "PublicBucket": "punched-media-delivery",
    "PublicBaseUrl": "https://media.example.invalid",
    "ServiceUrl": "https://ACCOUNT_ID.r2.cloudflarestorage.com",
    "Region": "auto",
    "PresignMinutes": 5,
    "PendingRowExpirationMinutes": 15,
    "PendingObjectLifecycleHours": 24,
    "Processing": { "LeaseMinutes": 5, "LeaseHeartbeatMinutes": 1, "MaxAttempts": 3 },
    "Retention": { "DeletedGraceHours": 0, "FailedUploadHours": 0, "QuarantineHours": 0 },
    "Limits": {
      "SupportedInputMimeTypes": [ "image/jpeg", "image/png", "image/webp" ],
      "Purposes": {}
    }
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Punched"
  }
}
