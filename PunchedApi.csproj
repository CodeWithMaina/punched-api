<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PunchedApi</RootNamespace>
    <UserSecretsId>punched-api-secrets</UserSecretsId>

    <!--
      PERFORMANCE/RECURSION FIX: the test project lives inside this project's
      directory. Without this, every default item glob (Compile, Content, None,
      EmbeddedResource, ...) enumerates PunchedApi.Tests\bin\** — a self-amplifying
      copy loop grew that tree to 45k+ files / 1.9 GB / depth 396, and every MSBuild
      evaluation (build, restore, design-time, watch) traversed it.
      seed-report.json is a runtime-generated report (Seed.ReportPath); excluding it
      prevents a dotnet-watch rebuild loop when seeding is enabled.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PunchedApi.Tests\**;seed-report.json</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Belt-and-braces: the Web SDK's JSON content glob may not honor
    DefaultItemExcludes; Remove after Include guarantees no test-project file
    (especially PunchedApi.Tests\bin\**\*.json) is ever copied into this
    project's output with a preserved relative path.
  -->
  <ItemGroup>
    <Compile Remove="PunchedApi.Tests\**" />
    <Content Remove="PunchedApi.Tests\**" />
    <EmbeddedResource Remove="PunchedApi.Tests\**" />
    <None Remove="PunchedApi.Tests\**" />
    <Folder Remove="PunchedApi.Tests\**" />
  </ItemGroup>

  <!-- Entity Framework Core + PostgreSQL -->
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.410.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <!--
      WebPush 1.0.12 is the only maintained release and still declares
      Newtonsoft.Json >= 10.0.3 and Portable.BouncyCastle >= 1.8.1.3. Both
      floors resolve to packages with published advisories, so they are pinned
      here to the first patched / modern equivalents:
        • Newtonsoft.Json 13.0.3 fixes GHSA-5crp-9r3c-p9vr (binary-compatible
          with the 10.x API WebPush compiles against).
        • Portable.BouncyCastle 1.9.0 drops the legacy NETStandard.Library 1.6.1
          graph, which is what dragged in the vulnerable System.Net.Http 4.3.0,
          System.Text.RegularExpressions 4.3.0 and runtime.native.* 4.3.0 shims.
      System.Security.Cryptography.Pkcs is raised past the version MimeKit 4.16
      resolves (8.0.1) to the patched 8.0.2 servicing release.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <!-- Authentication & Security -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <!-- Validation -->
  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <!--
      No mapping library is referenced. Entity → DTO projection is explicit
      (Application/Mappings/ResponseMappings.cs): the four mappings are flat
      property assignments, and every AutoMapper release that fixes the
      MaxDepth recusion advisories (GHSA-rvv3-g6hj-g44x, GHSA-gpwp-5797-mjff,
      GHSA-6vhm-j9h7-f9gh) is only licensed commercially.
    -->
  </ItemGroup>

  <!-- API Documentation -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
